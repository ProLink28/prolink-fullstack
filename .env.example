# Copy this file to ".env" and fill it in.

# SQLite file (created in the prisma/ folder). For PostgreSQL see the note in prisma/schema.prisma.
DATABASE_URL="file:./dev.db"

# Used to sign login tokens (JWT). Use any long random string.
JWT_SECRET="change-this-to-a-long-random-string"

PORT=3000

# Only needed if the front end is hosted somewhere else (e.g. GitHub Pages).
# Example: CORS_ORIGIN=https://prolink28.github.io
CORS_ORIGIN=

# Verification codes are emailed through EmailJS (same service/template you already use).
# In EmailJS: Account > Security > allow API calls from non-browser apps, then copy your Private Key here.
# If the private key is empty, codes are printed in the server console instead (handy for testing).
EMAILJS_SERVICE_ID=service_fs7cftu
EMAILJS_TEMPLATE_ID=template_c3ur72o
EMAILJS_PUBLIC_KEY=fmfWdjP7GgCW6cUEl
EMAILJS_PRIVATE_KEY=
